{
  "name": "wisdom-mcp",
  "version": "0.1.0",
  "license": "GPL-3.0-only",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@10.28.2",
  "scripts": {
    "build": "tsc -p .",
    "start": "node dist/main.js",
    "corpus:import": "pnpm build && node dist/scripts/import.js",
    "corpus:diff": "pnpm build && node dist/scripts/diff.js",
    "corpus:index": "pnpm build && node dist/scripts/index.js",
    "eval": "pnpm build && node dist/scripts/eval.js",
    "readings:draft": "pnpm build && node dist/scripts/readings.js",
    "typecheck": "tsc -p . --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "knip": "knip",
    "test": "pnpm build && node --test \"test/**/*.test.ts\""
  },
  "dependencies": {
    "@modelcontextprotocol/express": "^2.0.2",
    "@modelcontextprotocol/node": "^2.1.1",
    "@modelcontextprotocol/server": "^2.3.1",
    "@nestjs/common": "^12.3.1",
    "@nestjs/config": "^12.0.1",
    "@nestjs/core": "^12.3.1",
    "@nestjs/platform-express": "^12.3.1",
    "@nestjs/swagger": "^12.0.5",
    "@nestjs/throttler": "^6.7.1",
    "better-sqlite3": "^13.0.3",
    "express": "^5.3.0",
    "pinyin-pro": "^3.29.5",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "sqlite-vec": "^0.1.9",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/better-sqlite3": "^9.6.0",
    "@types/express": "^5.0.6",
    "@types/node": "^24.19.2",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "knip": "^6.43.0",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.0"
  },
  "pnpm": {
    "overrides": {
      "multer": "^2.5.0"
    },
    "onlyBuiltDependencies": [
      "better-sqlite3"
    ],
    "ignoredBuiltDependencies": [
      "@scarf/scarf"
    ]
  }
}
